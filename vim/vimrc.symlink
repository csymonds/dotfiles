set nocompatible

set nowrap
set tabstop=4
set shiftwidth=4
set autoindent
set smartindent
set expandtab
set showmatch
set ignorecase
set smartcase
set hlsearch
set incsearch
set nu
set title
set nojs
set backspace=2

" disable folding
set nofoldenable

" Default for VIM is tcq
set formatoptions+=roqn

" size in KB
set maxmempattern=20000

" Colors
set t_Co=256
colorscheme desert

" Set color bar to maintain readability
set cc=80

set showmode
set wildignore=*.swp,*.bak,*.pyc,*.class,*.jar,*.pdf,*.aux,*.bbl,*.bcf,*.blg,*.cls

" Alter recognition of file extensions
au BufNewFile,BufRead *.sbt setlocal ft=scala
au BufNewFile,BufRead *.gnu setlocal ft=gnuplot

filetype plugin indent on
autocmd Filetype python set nosmartindent copyindent
autocmd Filetype tex set wrap linebreak spell spelllang=en
autocmd Filetype make set noexpandtab
autocmd Filetype go set noexpandtab

" Set default .tex to latex
let g:tex_flavor = "latex"

" airline
set laststatus=2

" fzf
nnoremap <c-p> :Files<CR>
nnoremap <c-b> :Buffers<CR>
nnoremap <c-f> :Rg<CR>

" Trim whitespace when file is written
" autocmd BufWritePre * :%s/\s\+$//e

" Let go fmt do the work for *.go
autocmd FileType go autocmd BufWritePre <buffer> GoFmt

" Show when lines have wrapped
let &showbreak='>>'

" Move next sentence to next line
nnoremap <F2> f.li<CR><ESC>

" Rerun the last command
nnoremap <F5> :!!<CR>

" Toggle paste mode
nnoremap <F11> :set invpaste paste?<CR>

" Fix syntax highlighting when broken
nnoremap <F12> :syntax sync fromstart<CR>

" Make navigating long lines a bit nicer
nnoremap j gj
nnoremap k gk

" More accessible make
nnoremap mm :!ninja<CR>
nnoremap ,, :!./push<CR>

" Disable the arrow keys.
noremap <up> <nop>
noremap <down> <nop>
noremap <left> <nop>
noremap <right> <nop>

" Get out of insert mode without leaving the home row
inoremap jj <ESC>

" Aliases for ex commands
cnoreabbrev W w
cnoreabbrev Q q
cnoreabbrev WQ wq
cnoreabbrev Wq wq

" ----- LSP (yegappan/lsp) -----
" Configure language servers
function! s:LspSetup()
    var lspServers = [
        {
            'name': 'clangd',
            'filetype': ['c', 'cpp'],
            'path': '/usr/bin/clangd',
            'args': ['--background-index']
        },
        {
            'name': 'gopls',
            'filetype': ['go', 'gomod'],
            'path': 'gopls',
            'args': ['serve']
        }
    ]
    autocmd User LspSetup call LspAddServer(lspServers)
endfunction

if executable('clangd') || executable('gopls')
    autocmd VimEnter * call s:LspSetup()
endif

" LSP key mappings
nnoremap gd :LspGotoDefinition<CR>
nnoremap gr :LspShowReferences<CR>
nnoremap K :LspHover<CR>
nnoremap <leader>rn :LspRename<CR>
nnoremap <leader>ca :LspCodeAction<CR>
nnoremap [d :LspDiag prev<CR>
nnoremap ]d :LspDiag next<CR>
nnoremap <leader>ds :LspDiag show<CR>
