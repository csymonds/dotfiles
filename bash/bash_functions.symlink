# grep all files with a specific extension (recursively)
ext_grep() {
  local ext="$1"; shift
  find . -type f -name "*.$ext" -print0 | xargs -0 grep --color -n "$@"
}

# grep all java files (recursively)
jgrep() {
  ext_grep "java" "$@"
}

# grep all scala files (recursively)
sgrep() {
  ext_grep "scala" "$@"
}

# grep all python files (recursively)
pygrep() {
  ext_grep "py" "$@"
}

# grep all javascript/typescript files (recursively)
jsgrep() {
  find . -type f \( -name '*.js' -o -name '*.jsx' -o -name '*.ts' -o -name '*.tsx' \) -print0 | xargs -0 grep --color -n "$@"
}

# grep all c/cc/cpp/h files (recursively)
cgrep() {
  find . -type f \( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' \) -print0 | xargs -0 grep --color -n "$@"
}

# grep all text files (recursively)
texgrep() {
  ext_grep "tex" "$@"
}

# Create a directory and change into it
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Extract common archive formats
extract() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar.bz2)   tar xjf "$1"     ;;
      *.tar.gz)    tar xzf "$1"     ;;
      *.bz2)       bunzip2 "$1"     ;;
      *.rar)       unrar e "$1"     ;;
      *.gz)        gunzip "$1"      ;;
      *.tar)       tar xf "$1"      ;;
      *.tbz2)      tar xjf "$1"     ;;
      *.tgz)       tar xzf "$1"     ;;
      *.zip)       unzip "$1"       ;;
      *.Z)         uncompress "$1"  ;;
      *.7z)        7z x "$1"        ;;
      *)           echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# Get the current weather
weather() {
  local city="${1:-}"
  curl -s "wttr.in/${city}?m1"
}

# Find files recursively
ff() {
  find . -type f -name "*$1*"
}

# Find directories recursively
fd() {
  find . -type d -name "*$1*"
}

# Print a cheatsheet for common commands
cheatsheet() {
  local cmd="$1"
  curl -s "cheat.sh/$cmd"
}

# run dot on every dot in the current directory
batch_dot() {
  for file in *dot; do
    dot -Tps -o $file.ps $file
  done
}
