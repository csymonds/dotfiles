# Grab system-wide settings
[ -f /etc/bashrc ] && source /etc/bashrc

path_add() {
  [ -d "$1" ] && PATH="$PATH:$1"
}

path_add "$HOME/bin"
path_add "$HOME/.local/bin"

unset path_add

# If not running interactively, don't do anything
[ -z "$PS1" ] && return

# If running in a virtual console, set a timeout
if [ ! -z "$(tty | grep tty)" ]; then
  echo "Setting a timeout to close console after 10 mins of inactivity"
  TMOUT=600
fi

# Editor preference
export EDITOR=vim

# don't put duplicate lines in the history. See bash(1) for more options
# ... or force ignoredups and ignorespace
HISTCONTROL=ignoredups:ignorespace

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=10000
HISTFILESIZE=20000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# Make less more friendly for non-text input files
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# Alias and function definitions.
[ -f ~/.bash_aliases ] && source ~/.bash_aliases
[ -f ~/.bash_functions ] && source ~/.bash_functions

# cdargs functions for faster directory navigation
[ -f ~/.dotfiles/cdargs/cdargs-bash.sh ] && source ~/.dotfiles/cdargs/cdargs-bash.sh

# Update the terminal title
case "$TERM" in
xterm*|rxvt*|screen*)
  PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD/#$HOME/~}\007"'
  ;;
*)
  ;;
esac

# enable bash completion in interactive shells
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    source /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    source /etc/bash_completion
  fi
fi

# Set a colored prompt
if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
  # We have color support; assume it's compliant with Ecma-48
  # (ISO/IEC-6429). (Lack of such support is extremely rare, and such
  # a case would tend to support setf rather than setaf.)
  color_prompt=yes
else
  color_prompt=
fi

# Python virtual environment prompt configuration
export VIRTUAL_ENV_DISABLE_PROMPT=1

# Set prompt with virtual environment indicator
if [ "$color_prompt" = yes ]; then
  PS1='$(virtualenv_info)\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
  PS1='$(virtualenv_info)\u@\h:\w\$ '
fi
unset color_prompt

# Auto-activate Python virtual environment if present
if [ -d "venv" ] && [ -f "venv/bin/activate" ]; then
  source venv/bin/activate
elif [ -d ".venv" ] && [ -f ".venv/bin/activate" ]; then
  source .venv/bin/activate
fi

