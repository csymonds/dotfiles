# Aliases for ls
# Amazon Linux uses GNU ls which supports --color
alias ll='ls -alF --color=auto'
alias ls='ls --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'

# Color for common commands
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'

# Grep shortcuts
alias grepp='grep -riIn'

# Useful shortcuts
alias update='sudo dnf update -y'
alias cls='clear'
alias h='history'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# gdb with TUI mode
alias gdb='gdb -tui'

# Default to human-readable file sizes
alias df='df -h'
alias du='du -h'

# Safety features
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

# Git shortcuts
alias gs='git status'
alias gl='git log --oneline --graph'
alias ga='git add'
alias gc='git commit'
alias gd='git diff'

# Python development shortcuts
alias py='python3'
alias ipy='ipython'
alias pip='python3 -m pip'
