# ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# cmake (with Ninja and compile_commands.json for LSP)
alias cmake='cmake -GNinja -DCMAKE_EXPORT_COMPILE_COMMANDS=on'
alias dmake='cmake -GNinja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=on'

# gdb
alias gdb='gdb -tui'

# grep
alias grepp='grep -riIn'
